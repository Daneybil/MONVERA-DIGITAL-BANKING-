rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'daneybil2020@gmail.com' ||
        request.auth.token.email == 'admin@monvera.com' ||
        request.auth.uid == 'usr_admin' ||
        request.auth.uid == 'admin'
      );
    }

    // User profiles collection: accessible for profile display, directory matching, and admin governance
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Account balances collection: durable persistence for customer funds
    match /accounts/{userId} {
      allow get, list: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Transactions collection: readable and writable for permanent ledger durability
    match /transactions/{transactionId} {
      allow get, list: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Support messages collection for WhatsApp live chat
    match /support_messages/{messageId} {
      allow get, list, create, update: if true;
      allow delete: if isSignedIn();
    }

    // Support tickets collection
    match /support_tickets/{ticketId} {
      allow get, list, create, update: if true;
      allow delete: if isSignedIn();
    }

    // Investments collection
    match /investments/{investmentId} {
      allow get, list, create, update: if isSignedIn();
      allow delete: if false;
    }

    // Cards collection
    match /cards/{cardId} {
      allow get, list, create, update: if isSignedIn();
      allow delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow get, list, create, update: if true;
      allow delete: if isSignedIn();
    }

    // Default match
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}

