rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Cryptographic token & verified administrator check
    // Uses .get() to avoid evaluation errors when optional claims (admin, role) are absent from standard user tokens
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('role', '') == 'super_admin' ||
        (
          request.auth.token.get('email_verified', false) == true && (
            request.auth.token.get('email', '') == 'daneybil2020@gmail.com' ||
            request.auth.token.get('email', '') == 'admin@monvera.com'
          )
        )
      );
    }

    // 1. User Profiles Collection: users/{userId}
    // Full profile reads restricted to the authentic owner or verified admin.
    // Listing the entire collection is restricted to administrators.
    // Privilege escalation prevention: Customers cannot modify roles, freeze status, or transaction limits.
    // KYC Integrity: Customers cannot change kycStatus, kycVerifiedAt, or kycItemReviews.
    // Legal Name Locking: If verified, customers cannot modify legal names without compliance review.
    match /users/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'customer') &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
        (!('dailyTransactionLimit' in request.resource.data) || request.resource.data.dailyTransactionLimit <= 1000000) &&
        (!('kycStatus' in request.resource.data) || request.resource.data.kycStatus == 'unverified') &&
        (!('kycVerifiedAt' in request.resource.data) || request.resource.data.kycVerifiedAt == null) &&
        (!('kycItemReviews' in request.resource.data) || request.resource.data.kycItemReviews == null)
      );

      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        // Prevent role tampering
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.get('role', null) || (resource.data.get('role', null) == null && request.resource.data.role == 'customer')) &&
        // Prevent account status/freeze tampering
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.get('status', null) || (resource.data.get('status', null) == null && request.resource.data.status == 'active')) &&
        // Prevent dailyTransactionLimit escalation
        (!('dailyTransactionLimit' in request.resource.data) || request.resource.data.dailyTransactionLimit == resource.data.get('dailyTransactionLimit', null)) &&
        // Prevent KYC status self-promotion / tampering
        (!('kycStatus' in request.resource.data) || request.resource.data.kycStatus == resource.data.get('kycStatus', null) || (resource.data.get('kycStatus', null) == null && request.resource.data.kycStatus == 'unverified')) &&
        (!('kycVerifiedAt' in request.resource.data) || request.resource.data.kycVerifiedAt == resource.data.get('kycVerifiedAt', null)) &&
        (!('kycItemReviews' in request.resource.data) || request.resource.data.kycItemReviews == resource.data.get('kycItemReviews', null)) &&
        // Legal Name Locking: Verified customers cannot alter legal names directly
        (resource.data.get('kycStatus', 'unverified') != 'verified' || (
          (!('firstName' in request.resource.data) || request.resource.data.firstName == resource.data.get('firstName', null)) &&
          (!('lastName' in request.resource.data) || request.resource.data.lastName == resource.data.get('lastName', null)) &&
          (!('fullName' in request.resource.data) || request.resource.data.fullName == resource.data.get('fullName', null)) &&
          (!('kycFullName' in request.resource.data) || request.resource.data.kycFullName == resource.data.get('kycFullName', null))
        ))
      );

      allow delete: if false;

      // KYC Documents Subcollection: Private documents restricted to owner and administrator
      match /kyc_documents/{docId} {
        allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
        allow create, update, delete: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      }

      // User Notification Preferences Subcollection
      match /notificationPreferences/{docId} {
        allow read, create, update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
        allow delete: if isAdmin();
      }

      // User Push Notification Tokens Subcollection
      match /notificationTokens/{tokenId} {
        allow read, create, update, delete: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      }
    }

    // 2. Account Balances Collection: accounts/{userId}
    // Restricted to authentic account owner and administrators.
    // Direct client balance modifications are completely blocked;
    // all balance adjustments occur authoritatively via Firebase Admin SDK.
    match /accounts/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 3. Transactions Collection: transactions/{transactionId}
    // Financial ledger integrity: Direct client writes, updates, or deletions are strictly prohibited.
    // Authenticated customers can read only transactions where they are owner, sender, or recipient.
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (
        isSignedIn() && resource != null && (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('senderUserId', '') == request.auth.uid ||
          resource.data.get('recipientUserId', '') == request.auth.uid
        )
      );
      allow create, update, delete: if isAdmin();
    }

    // 4. Term Investments Collection: investments/{investmentId}
    // Ownership enforced: Only the investment owner or administrator can view investment details.
    // Financial fields (principal, returns, status) cannot be manipulated by client SDK.
    match /investments/{investmentId} {
      allow read: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // 5. Debit & Virtual Cards Collection: cards/{cardId}
    // Access restricted to the authentic card owner.
    // Customers can manage only their own cards (freeze toggle, self spending limits).
    match /cards/{cardId} {
      allow read: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 6. Notifications Collection: notifications/{notificationId}
    // Private notifications: Customers can access, update read status, and dismiss only their own notifications.
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);
    }

    // Root Notification Preferences & Push Tokens
    match /notification_preferences/{userId} {
      allow read, create, update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /notification_tokens/{tokenId} {
      allow read: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);
    }

    // 7. Support Messages & Live Chat Collections
    // Private support thread between the customer and compliance/support administrators.
    match /support_messages/{messageId} {
      allow read: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);
    }

    match /support_typing/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);
    }

    // 8. Loans & Credit Facilities Collection: loans/{loanId}
    // Read: Admin or authenticated borrower who owns the record.
    // Create: Enforces initial 'PENDING' status and zero disbursement/repayment fields.
    // Update: Non-privileged owner updates only; financial fields and status are frozen from client tampering.
    // Delete: Administrators only.
    match /loans/{loanId} {
      allow read: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);

      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('status', '') == 'PENDING' &&
        (!('disbursedAmount' in request.resource.data) || request.resource.data.disbursedAmount == 0) &&
        (!('totalRepaid' in request.resource.data) || request.resource.data.totalRepaid == 0) &&
        (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == '') &&
        (!('approvedBy' in request.resource.data) || request.resource.data.approvedBy == '') &&
        (!('disbursedAt' in request.resource.data) || request.resource.data.disbursedAt == '') &&
        (!('rejectedAt' in request.resource.data) || request.resource.data.rejectedAt == '') &&
        (!('rejectedBy' in request.resource.data) || request.resource.data.rejectedBy == '') &&
        (!('repaymentHistory' in request.resource.data) || request.resource.data.repaymentHistory.size() == 0)
      );

      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('status', null) == resource.data.get('status', null) &&
        request.resource.data.get('disbursedAmount', 0) == resource.data.get('disbursedAmount', 0) &&
        request.resource.data.get('disbursedAt', '') == resource.data.get('disbursedAt', '') &&
        request.resource.data.get('approvedAt', '') == resource.data.get('approvedAt', '') &&
        request.resource.data.get('approvedBy', '') == resource.data.get('approvedBy', '') &&
        request.resource.data.get('rejectedAt', '') == resource.data.get('rejectedAt', '') &&
        request.resource.data.get('rejectedBy', '') == resource.data.get('rejectedBy', '') &&
        request.resource.data.get('totalRepaid', 0) == resource.data.get('totalRepaid', 0) &&
        request.resource.data.get('remainingBalance', null) == resource.data.get('remainingBalance', null) &&
        request.resource.data.get('repaymentHistory', []) == resource.data.get('repaymentHistory', [])
      );

      allow delete: if isAdmin();
    }

    // 12. Card Activation Requests: card_activation_requests/{requestId}
    // Customers can submit pending activation codes and view their own requests.
    // Administrators can list, inspect, approve, and reject requests.
    match /card_activation_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource != null && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('status', '') == 'PENDING'
      );
      allow update, delete: if isAdmin();
    }

    // 13. Admin-Issued Checks Collection: issued_checks/{checkId}
    // Authoritative check records written strictly by Firebase Admin SDK backend.
    // Direct browser-side creates, updates, and deletes are strictly prohibited.
    match /issued_checks/{checkId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // 14. Check Issuance Idempotency & Check Number Lock Collections
    // Backend-only atomic lock documents managed exclusively via Firebase Admin SDK.
    match /check_idempotency/{idempotencyKey} {
      allow read, write: if false;
    }

    match /check_number_locks/{normalizedCheckNumber} {
      allow read, write: if false;
    }

    // 15. Durable Notification Outbox & Server Dispatch Logs
    // Strictly backend-only operational records managed exclusively via Firebase Admin SDK.
    // Direct browser-side reads, creates, updates, and deletes are strictly prohibited.
    match /notification_outbox/{outboxId} {
      allow read, write: if false;
    }

    match /notification_dispatch_logs/{logId} {
      allow read, write: if false;
    }

    // Default Fallback: Fail closed on all unspecified collections and paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
